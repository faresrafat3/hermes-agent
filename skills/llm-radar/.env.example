# LLM Radar - API Keys for Free Providers
# Copy this to ~/.hermes/.env and fill in your keys
# Only providers with valid keys will be benchmarked

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral AI - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cloudflare Workers AI - https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Models - https://github.com/settings/tokens
GITHUB_TOKEN=
